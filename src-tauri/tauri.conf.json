{
  "productName": "m7-editor",
  "version": "1.8.0",
  "identifier": "com.jerryeee.m7-editor",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 2388",
    "devUrl": "http://localhost:2388",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "m7-editor",
        "width": 2560,
        "height": 1600,
        "devtools": true,
        "maximized": true
      }
    ],
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "showMenuOnLeftClick": false,
      "tooltip": "m7-editor"
    },
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    }
  }
}
